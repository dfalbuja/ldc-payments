{
  "name": "ldc-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión de mensualidades y control de morosidad - Liga Deportiva Cantonal Antonio Ante (prototipo PostgreSQL + MongoDB)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node scripts/db-reset.js",
    "mora": "node scripts/mora.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1"
  }
}
