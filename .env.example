# Copiar a .env y ajustar a la instalación local.

# PostgreSQL: node-postgres lee estas variables directamente.
# En macOS con Homebrew el usuario es el de la sesión y no lleva clave;
# en Windows normalmente es PGUSER=postgres con la clave del instalador.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ldc_payments
# PGUSER=postgres
# PGPASSWORD=

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ldc_payments

# Puerto de la aplicación web
PORT=4300
